# Redis Configuration (for distributed caching across multiple instances)
REDIS_URL=redis://:password@localhost:6379

# MinIO Configuration (for object storage of rendered PDFs)
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET_NAME=pdf-renders

# MongoDB Configuration (for tracking jobs and metadata)
MONGO_URL=mongodb://user:password@localhost:27017/?authSource=admin

# Application
LOG_LEVEL=INFO
